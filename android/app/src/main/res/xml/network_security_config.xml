<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 局域网明文 HTTP（电脑端 exe 通过 http 访问本机服务） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
